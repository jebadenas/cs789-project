# Data Privacy (Crucial for CS789)
# Deny everything under data/, then re-allow structure markers only.
# The negation for directories is required or git will not descend far
# enough to apply the .gitkeep/README exceptions.
data/**
!data/**/
!data/.gitkeep
!data/**/.gitkeep
!data/**/README.md

# Explicit, redundant, and deliberate — identifiable student journals.
data/journals/

# Generated output
output/

# Python Environment
.venv/
__pycache__/
*.pyc

# IDE / Mac files
.DS_Store
.idea/
.ipynb_checkpoints/
# Next.js apps
**/node_modules
**/.next
**/*.tsbuildinfo
ui/src/app/dashboard/teams.data.json
ui/src/app/dashboard/cohorts.data.json
survey/src/app/cases.data.json

# prototypes — contain real journal quotes and names, never commit
prototypes/

# Claude Code internal config
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# R session cruft
.Rhistory
.Rproj.user/
